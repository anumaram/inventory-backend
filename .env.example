# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.g9zvpiq.mongodb.net/inventory-app?retryWrites=true&w=majority

# Port (auto-assigned by Render, defaults to 3000 locally)
PORT=3000

# Node Environment
NODE_ENV=production

# JWT Secrets
JWT_SECRET=supersecretjwtkey_change_me_in_production

# Optional: Comma-separated list of additional allowed origins for CORS
# ALLOWED_ORIGINS=https://your-custom-domain.com

# Email Service (Brevo HTTPS API - Delivers to ANY email over HTTPS on Render):
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=noreply.2k2x@gmail.com
SENDER_NAME=Inventory App

# Fallback Email Service (Resend HTTPS API):
RESEND_API_KEY=your_resend_api_key_here


